# Server-only OpenAI key for AI chart analysis. Never expose this in browser code.
OPENAI_API_KEY=
# Optional model override. The application defaults to gpt-5.4.
OPENAI_MODEL=gpt-5.4
# Gmail SMTP（需啟用兩步驟驗證並建立 App Password）
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=投資研究工作台
# 會員申請通知收件人；未設定時使用 GMAIL_USER。
MEMBERSHIP_REVIEW_EMAIL=
